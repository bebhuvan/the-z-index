---
// Line icons for a piece's format. 16px, 1.5 stroke (the same as the search icon), currentColor.
const { format, label = true } = Astro.props;
const TITLE = { read: 'Newsletter', video: 'Video', audio: 'Podcast' };
---
<svg class="ficon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : null} aria-label={label ? TITLE[format] : null} aria-hidden={label ? null : 'true'}>
  {format === 'video' ? (
    <>
      <rect x="1.75" y="3.25" width="12.5" height="9.5" rx="2" />
      <path d="M6.75 6.1v3.8L9.9 8z" fill="currentColor" stroke-width="1" />
    </>
  ) : format === 'audio' ? (
    <path d="M2.5 7v2M5 5v6M7.5 3v10M10 5.5v5M12.5 7v2" />
  ) : (
    <>
      <path d="M4 1.75h5.5L12.5 4.75v9.5H4z" />
      <path d="M9.25 1.75v3.25h3.25M6 8h4.5M6 10.5h4.5" />
    </>
  )}
</svg>
